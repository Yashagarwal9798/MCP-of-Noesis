<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#1B1F2E">
  <ListBox ItemsSource="{Binding Items}" Width="320" Height="300">
    <ListBox.ItemTemplate>
      <DataTemplate>
        <StackPanel Orientation="Horizontal">
          <Rectangle Width="16" Height="16" Fill="{Binding Color}" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding Name}"/>
        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</Grid>
